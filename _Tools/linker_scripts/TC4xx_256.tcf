  <configuration name="linker_command_file" filename="link_cmd.txt">
    <string><![CDATA[
# SYSTEM memory regions indicate where external memory might be located.
#   The TCF has no specific knowledge of whether SYSTEM regions contain 
#   external memory or not.
# CCMWRAP memory regions indicate unusable portions of the address space
#   due to CCM memory wrapping into upper addresses beyond its size

MEMORY {
    SYSTEM0 : ORIGIN = 0x00000000, LENGTH = 0x92080000
    CSM     : ORIGIN = 0x92080000, LENGTH = 0x00080000
#   CCMWRAP0: ORIGIN = 0x90080000, LENGTH = 0x02000000
    IVT     : ORIGIN = 0x92100000, LENGTH = 0x0df00000
#   SYSTEM1 : ORIGIN = 0xa0000000, LENGTH = 0x20000000
    VECTMEM : ORIGIN = 0xc0000000, LENGTH = 0x01000000
#   CCMWRAP2: ORIGIN = 0xc0020000, LENGTH = 0x0ffe0000
#   SYSTEM2 : ORIGIN = 0xd0000000, LENGTH = 0x10000000
    DMP0    : ORIGIN = 0xe0000000, LENGTH = 0x10000000
#   MSS_CLK : ORIGIN = 0xf0000000, LENGTH = 0x00001000
#   SYSTEM3 : ORIGIN = 0xf0001000, LENGTH = 0x01fff000
#   MSS_PERF: ORIGIN = 0xf2000000, LENGTH = 0x00002000
#   SYSTEM4 : ORIGIN = 0xf2002000, LENGTH = 0x0dffe000
    }
SECTIONS {
    GROUP BLOCK(4) : {
	.text? : { *('.text$crt*') }
        * (TEXT): {}
    	* (LIT): {}
	} > SYSTEM0

    GROUP BLOCK(4): {
	/* _SDA_BASE_ computed implicitly */
        .sdata?: {}
        .sbss?: {}
        * (DATA): {}
        * (BSS): {}
       .stack ALIGN(4) SIZE(DEFINED _STACKSIZE?_STACKSIZE:65536): {}
       _end = . ;
       .heap? ALIGN(4) SIZE(DEFINED _HEAPSIZE?_HEAPSIZE:0): {}
	} > SYSTEM0
    GROUP BLOCK(4) : {
        .vectors (TEXT) SIZE(DEFINED _IVTSIZE?_IVTSIZE:644): {} = FILL(0xa5a5a5a5,4)
        } > IVT
    /* Vector memory is filled out to its full size to allow ECC memory
     * initialization with -Bzerobss. If you don't want this behavior
     * specify -lcf_ccm_fill false to the TCF generator.
     */
    GROUP ALIGN(64) SIZE(SIZEOF(VECTMEM)): {
        .vecmem_data? : {}
        .vecstack ALIGN(64) SIZE(DEFINED _VEC_STACKSIZE?_VEC_STACKSIZE:8192): {}
        } = 0 > VECTMEM
    GROUP ALIGN(64) BLOCK(8): {
        .csm_data? : {}
        } > CSM
    }

]]></string>
  </configuration>
  <configuration name="gnu_linker_command_file" filename="memory.x">
    <string><![CDATA[
MEMORY {
    SYSTEM0  : ORIGIN = 0x00000000, LENGTH = 0x92080000
    CSM      : ORIGIN = 0x92080000, LENGTH = 0x00080000
    CCMWRAP0 : ORIGIN = 0x90080000, LENGTH = 0x02000000
    IVT      : ORIGIN = 0x92080000, LENGTH = 0x0df80000
    SYSTEM1  : ORIGIN = 0xa0000000, LENGTH = 0x20000000
    VECTMEM  : ORIGIN = 0xc0000000, LENGTH = 0x00020000
    CCMWRAP2 : ORIGIN = 0xc0020000, LENGTH = 0x0ffe0000
    SYSTEM2  : ORIGIN = 0xd0000000, LENGTH = 0x10000000
    DMP0     : ORIGIN = 0xe0000000, LENGTH = 0x10000000
    MSS_CLK  : ORIGIN = 0xf0000000, LENGTH = 0x00001000
    SYSTEM3  : ORIGIN = 0xf0001000, LENGTH = 0x01fff000
    MSS_PERF : ORIGIN = 0xf2000000, LENGTH = 0x00002000
    SYSTEM4  : ORIGIN = 0xf2002000, LENGTH = 0x0dffe000
    }
REGION_ALIAS("startup", SYSTEM0)
REGION_ALIAS("text", SYSTEM0)
REGION_ALIAS("data", SYSTEM0)
REGION_ALIAS("sdata", SYSTEM0)
PROVIDE (__stack_top = (0x8fffffff & -4 ));
PROVIDE (__end_heap =  (0x8fffffff ));
]]></string>
  </configuration>
