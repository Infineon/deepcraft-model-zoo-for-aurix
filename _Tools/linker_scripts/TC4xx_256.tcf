  <configuration name="alb_mss_fab_system_memmap.s" filename="alb_mss_fab_system_memmap.s">
    <string><![CDATA[
// System memory map

.equ MSS_CLKCTRL_0_BASE, 0xf0000000
.equ MSS_CLKCTRL_0_SIZE, 0x1000
.equ VMEM_AXI_0_BASE, 0xc0000000
.equ VMEM_AXI_0_SIZE, 0x1000000
.equ CSM_DMI_AXI_0_BASE, 0xc1000000
.equ CSM_DMI_AXI_0_SIZE, 0x80000
.equ STU_DMI_AXI_0_BASE, 0xc1080000
.equ STU_DMI_AXI_0_SIZE, 0x1000
.equ DDR3_AXI_0_BASE, 0x0000
.equ DDR3_AXI_0_SIZE, 0x40000000
.equ MSS_PERFCTRL_0_BASE, 0xf2000000
.equ MSS_PERFCTRL_0_SIZE, 0x2000
.equ MSS_MEM_0_BASE, 0xe0000000
.equ MSS_MEM_0_SIZE, 0x80000
.equ MSS_SFTY_0_BASE, 0xf0009000
.equ MSS_SFTY_0_SIZE, 0x1000

// when default slave is not set, there may be unallocated memory space in the system
// following statements report the total unallocated region and its corresponding
// start address and end address in system memory map
// NOTE: the info is credit for 32-bit space, may inaccurate in 40-bit memory space
//       due to limitation of VPP expression to handle more than 2^32 values


.equ UNALLOC_SPACE_NUM,       6
.equ UNALLOC_SPACE_0_START_ADDR,  0x40000000  //1073741824
.equ UNALLOC_SPACE_0_END_ADDR,    0xbfffffff  //3221225471
.equ UNALLOC_SPACE_1_START_ADDR,  0xc1081000  //3238531072
.equ UNALLOC_SPACE_1_END_ADDR,    0xdfffffff  //3758096383
.equ UNALLOC_SPACE_2_START_ADDR,  0xe0080000  //3758620672
.equ UNALLOC_SPACE_2_END_ADDR,    0xefffffff  //4026531839
.equ UNALLOC_SPACE_3_START_ADDR,  0xf0001000  //4026535936
.equ UNALLOC_SPACE_3_END_ADDR,    0xf0008fff  //4026568703
.equ UNALLOC_SPACE_4_START_ADDR,  0xf000a000  //4026572800
.equ UNALLOC_SPACE_4_END_ADDR,    0xf1ffffff  //4060086271
.equ UNALLOC_SPACE_5_START_ADDR,  0xf2002000  //4060094464
.equ UNALLOC_SPACE_5_END_ADDR,    0xffffffff  //4294967295

// CCM system address with the specific name
.equ VMEM_SYS_BASE, 0xc0000000
.equ VMEM_SYS_SIZE, 0x1000000

.equ HAS_DEFAULT_SLAVE, 0
]]></string>
