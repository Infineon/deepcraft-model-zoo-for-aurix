*.Identifier
*.pyc
*.swp
*.npz
*.tfrecords
*.pth
*.log

venv/

# IDC tool loader cache and credentials
_CentralScripts/tool_loader/downloads/
_CentralScripts/tool_loader/infineon.cookies
_CentralScripts/tool_loader/infineon.auth
_CentralScripts/tool_loader/infineon.session.json
_CentralScripts/tool_loader/*.part
